# Render: set these values in the Environment page. Never commit real credentials.
# A local .env file is NOT loaded automatically; set shell variables before starting.
PROJECT_ID=your-google-cloud-project-id
GOOGLE_CREDENTIALS={paste the complete service-account JSON in your deployment settings}
VERTEX_LOCATION=global
GFJPROXY_XUID_SECRET=keep-your-existing-value
# Optional: restrict the JanitorAI access tokens that this server accepts.
GFJPROXY_ACCESS_KEYS=your-private-proxy-token
# Optional: preserve user settings and enable request statistics with Redis.
GFJPROXY_REDIS_URL=redis://localhost:6379/
GFJPROXY_PROCESS_TIMEOUT=300
# For local development only:
# GFJPROXY_DEVELOPMENT=1
